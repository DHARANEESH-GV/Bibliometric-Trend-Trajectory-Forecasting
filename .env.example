# biblio-trend environment — copy to .env and fill in.
# .env is git-ignored; never commit real keys.

# ── Phase 3.5 — patents (human interaction point #1) ────────────────────────
# USPTO Open Data Portal (ODP). The legacy PatentsView API died 2026-03-20:
# search.patentsview.org is NXDOMAIN and the old PATENTSVIEW_API_KEY is void.
# ODP key requires: USPTO.gov account + ID.me identity verification.
#   1. Create/verify account at https://data.uspto.gov
#   2. MyODP → Manage API Key → Activate
#   3. Keep profile fields current — keys lapse if USPTO profile requirements
#      (extra identity fields, MFA) are not met.
# Rate model: ~5M metadata calls/week, but only ONE in-flight call per key;
# concurrent calls with the same key are blocked. On HTTP 429 wait >= 5s.
USPTO_ODP_API_KEY=

# ── Phase 1 — papers (no key needed) ────────────────────────────────────────
# OpenAlex polite pool: set your contact email so requests land in the
# polite pool (10 req/s, 1000 credits/day/IP — see config/settings.yaml).
OPENALEX_MAILTO=
