{
  "name": "biblio-trend-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-snapshots.mjs",
    "dev": "vite",
    "live": "vite --port 5180 --host",
    "prebuild": "node scripts/copy-snapshots.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/preflight.mjs",
    "audit": "node scripts/render-audit.mjs",
    "pixel": "node scripts/pixel-audit.mjs",
    "verify": "node scripts/preflight.mjs && npm run build && node scripts/render-audit.mjs && node scripts/pixel-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders-react": "^0.0.81",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "echarts": "^5.5.0",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.63.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
